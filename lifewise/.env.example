# LifeWise AI environment template. Copy to .env.local. Never commit real secrets.
# None of these variables are read by the calculation engine yet.

# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/lifewise_dev"

# Session signing secret (min 32 random characters). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the app
APP_URL="http://localhost:3000"

# Optional AI provider (disabled when unset; the app must work without it)
AI_PROVIDER=""          # e.g. "anthropic" | "openai-compatible" | "" (disabled)
AI_API_KEY=""           # server-side only, never exposed to the browser
AI_MODEL=""
AI_TIMEOUT_MS="15000"
AI_DAILY_TOKEN_BUDGET="0"

# Optional email notifications (disabled when unset)
EMAIL_PROVIDER=""
EMAIL_FROM=""
